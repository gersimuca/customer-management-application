{
  "id": null,
  "title": "Spring Boot Monitoring",
  "timezone": "browser",
  "schemaVersion": 36,
  "version": 2,
  "refresh": "10s",
  "panels": [
    {
      "type": "graph",
      "title": "CPU Usage",
      "datasource": "Prometheus",
      "targets": [
        { "expr": "process_cpu_usage", "legendFormat": "CPU Usage", "refId": "A" }
      ],
      "yaxes": [
        { "format": "percent", "label": "CPU", "logBase": 1, "min": 0, "max": 1 },
        { "format": "short", "show": false }
      ],
      "gridPos": { "h": 8, "w": 12, "x": 0,  "y": 0 }
    },
    {
      "type": "graph",
      "title": "JVM Memory Used",
      "datasource": "Prometheus",
      "targets": [
        {
          "expr": "jvm_memory_used_bytes{area=\"heap\"}",
          "legendFormat": "{{area}} memory used",
          "refId": "A"
        }
      ],
      "yaxes": [
        { "format": "bytes", "label": "Memory", "logBase": 1 },
        { "format": "short", "show": false }
      ],
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 0 }
    },
    {
      "type": "graph",
      "title": "HTTP Request Count",
      "datasource": "Prometheus",
      "targets": [
        {
          "expr": "sum(rate(http_server_requests_seconds_count[1m]))",
          "legendFormat": "Requests/sec",
          "refId": "A"
        }
      ],
      "yaxes": [
        { "format": "ops", "label": "Requests/sec", "logBase": 1 },
        { "format": "short", "show": false }
      ],
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 8 }
    },
    {
      "type": "stat",
      "title": "Uptime",
      "datasource": "Prometheus",
      "targets": [
        {
          "expr": "time() - process_start_time_seconds",
          "legendFormat": "Uptime",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": { "unit": "s", "decimals": 0 },
        "overrides": []
      },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 8 }
    },
    {
      "type": "table",
      "title": "Recent HTTP Requests",
      "datasource": "Prometheus",
      "targets": [
        {
          "expr": "topk(5, sort_desc(sum by(uri, status) (rate(http_server_requests_seconds_count[5m]))))",
          "format": "table",
          "legendFormat": "{{uri}} ({{status}})",
          "refId": "A"
        }
      ],
      "transformations": [
        {
          "id": "filterFieldsByName",
          "options": { "include": ["uri", "status", "value"] }
        },
        {
          "id": "organize",
          "options": {
            "indexByName": { "uri": 0, "status": 1, "value": 2 },
            "renameByName": { "value": "Requests/sec" }
          }
        }
      ],
      "options": {
        "showHeader": true,
        "rowHeight": "36px",
        "fontSize": "14px",
        "cellDisplayMode": "auto"
      },
      "fieldConfig": {
        "defaults": {
          "mappings": [],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "red",   "value": 100 }
            ]
          }
        },
        "overrides": [
          {
            "matcher": { "id": "byName", "options": "Requests/sec" },
            "properties": [
              { "id": "unit",     "value": "ops" },
              { "id": "decimals", "value": 2 }
            ]
          }
        ]
      },
      "gridPos": { "h": 8, "w": 24, "x": 0, "y": 16 },
      "id": 5
    }
  ]
}
