{
  "annotations": {
    "list": []
  },
  "editable": true,
  "id": null,
  "title": "ERP API Service Dashboard",
  "uid": "erp-api-service-dashboard",
  "tags": [
    "erp-api-service",
    "slo",
    "latency",
    "observability"
  ],
  "schemaVersion": 38,
  "version": 1,
  "refresh": "10s",
  "timezone": "",

  "panels": [

    {
      "title": "JVM Heap Used (MB)",
      "type": "timeseries",
      "gridPos": { "h": 7, "w": 12, "x": 0, "y": 0 },
      "targets": [
        {
          "expr": "jvm_memory_used_bytes{area=\"heap\"} / 1024 / 1024",
          "legendFormat": "heap",
          "refId": "A"
        }
      ]
    },

    {
      "title": "JVM Non-Heap Used (MB)",
      "type": "timeseries",
      "gridPos": { "h": 7, "w": 12, "x": 12, "y": 0 },
      "targets": [
        {
          "expr": "jvm_memory_used_bytes{area=\"nonheap\"} / 1024 / 1024",
          "legendFormat": "nonheap",
          "refId": "A"
        }
      ]
    },

    {
      "title": "CPU Usage (%)",
      "type": "timeseries",
      "gridPos": { "h": 7, "w": 12, "x": 0, "y": 7 },
      "targets": [
        {
          "expr": "system_cpu_usage * 100",
          "legendFormat": "cpu",
          "refId": "A"
        }
      ]
    },

    {
      "title": "Live Threads",
      "type": "timeseries",
      "gridPos": { "h": 7, "w": 12, "x": 12, "y": 7 },
      "targets": [
        {
          "expr": "jvm_threads_live_threads",
          "legendFormat": "threads",
          "refId": "A"
        }
      ]
    },

    {
      "title": "Request Rate (RPS)",
      "type": "timeseries",
      "gridPos": { "h": 7, "w": 12, "x": 0, "y": 14 },
      "targets": [
        {
          "expr": "sum(rate(http_server_requests_seconds_count[1m]))",
          "legendFormat": "rps",
          "refId": "A"
        }
      ]
    },

    {
      "title": "Error Rate (%)",
      "type": "timeseries",
      "gridPos": { "h": 7, "w": 12, "x": 12, "y": 14 },
      "targets": [
        {
          "expr": "100 * sum(rate(http_server_requests_seconds_count{status=~\"5..\"}[5m])) / sum(rate(http_server_requests_seconds_count[5m]))",
          "legendFormat": "error %",
          "refId": "A"
        }
      ]
    },

    {
      "title": "Latency P50 / P90",
      "type": "timeseries",
      "gridPos": { "h": 7, "w": 12, "x": 0, "y": 21 },
      "targets": [
        {
          "expr": "histogram_quantile(0.50, sum(rate(http_server_requests_seconds_bucket[5m])) by (le)) * 1000",
          "legendFormat": "p50",
          "refId": "A"
        },
        {
          "expr": "histogram_quantile(0.90, sum(rate(http_server_requests_seconds_bucket[5m])) by (le)) * 1000",
          "legendFormat": "p90",
          "refId": "B"
        }
      ]
    },

    {
      "title": "Latency P95 / P99",
      "type": "timeseries",
      "gridPos": { "h": 7, "w": 12, "x": 12, "y": 21 },
      "targets": [
        {
          "expr": "histogram_quantile(0.95, sum(rate(http_server_requests_seconds_bucket[5m])) by (le)) * 1000",
          "legendFormat": "p95",
          "refId": "A"
        },
        {
          "expr": "histogram_quantile(0.99, sum(rate(http_server_requests_seconds_bucket[5m])) by (le)) * 1000",
          "legendFormat": "p99",
          "refId": "B"
        }
      ]
    },

    {
      "title": "Tail Latency P99.9 / P99.99",
      "type": "timeseries",
      "gridPos": { "h": 7, "w": 12, "x": 0, "y": 28 },
      "targets": [
        {
          "expr": "histogram_quantile(0.999, sum(rate(http_server_requests_seconds_bucket[10m])) by (le)) * 1000",
          "legendFormat": "p99.9",
          "refId": "A"
        },
        {
          "expr": "histogram_quantile(0.9999, sum(rate(http_server_requests_seconds_bucket[10m])) by (le)) * 1000",
          "legendFormat": "p99.99",
          "refId": "B"
        }
      ]
    },

    {
      "title": "SLO Error Rate (threshold based)",
      "type": "timeseries",
      "gridPos": { "h": 7, "w": 12, "x": 12, "y": 28 },
      "targets": [
        {
          "expr": "1 - (sum(rate(http_server_requests_seconds_bucket{le=\"0.3\"}[5m])) / sum(rate(http_server_requests_seconds_count[5m])))",
          "legendFormat": "error rate",
          "refId": "A"
        }
      ]
    },

    {
      "title": "Burn Rate (1h)",
      "type": "timeseries",
      "gridPos": { "h": 7, "w": 8, "x": 0, "y": 35 },
      "targets": [
        {
          "expr": "(1 - (sum(rate(http_server_requests_seconds_bucket{le=\"0.3\"}[1h])) / sum(rate(http_server_requests_seconds_count[1h])))) / 0.01",
          "legendFormat": "burn 1h",
          "refId": "A"
        }
      ]
    },

    {
      "title": "Burn Rate (6h)",
      "type": "timeseries",
      "gridPos": { "h": 7, "w": 8, "x": 8, "y": 35 },
      "targets": [
        {
          "expr": "(1 - (sum(rate(http_server_requests_seconds_bucket{le=\"0.3\"}[6h])) / sum(rate(http_server_requests_seconds_count[6h])))) / 0.01",
          "legendFormat": "burn 6h",
          "refId": "A"
        }
      ]
    },

    {
      "title": "Burn Rate (24h)",
      "type": "timeseries",
      "gridPos": { "h": 7, "w": 8, "x": 16, "y": 35 },
      "targets": [
        {
          "expr": "(1 - (sum(rate(http_server_requests_seconds_bucket{le=\"0.3\"}[24h])) / sum(rate(http_server_requests_seconds_count[24h])))) / 0.01",
          "legendFormat": "burn 24h",
          "refId": "A"
        }
      ]
    },

    {
      "title": "Per Endpoint Latency (P95)",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 24, "x": 0, "y": 42 },
      "targets": [
        {
          "expr": "histogram_quantile(0.95, sum(rate(http_server_requests_seconds_bucket[5m])) by (le, uri)) * 1000",
          "legendFormat": "{{uri}}",
          "refId": "A"
        }
      ]
    }

  ]
}